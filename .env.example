# Environment-variable reference only. Kong does NOT automatically load .env.
# Set only the variable(s) named by your selected kong.local.toml profile.
# Leave unused variables empty. Never commit populated .env or local credentials.
# PowerShell 7: $env:KONG_API_KEY = Read-Host "Model API key" -MaskInput
# Bash: read -rs KONG_API_KEY; export KONG_API_KEY

# DeepSeek profile
DEEPSEEK_API_KEY=
# Chat Completions compatible relay profile
KONG_API_KEY=
# Local profiles: leave empty if the local service does not require authentication.
KONG_LOCAL_API_KEY=
# Optional web search: choose the provider configured in [web].
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Optional MCP Authorization header: supply the complete header value locally.
YOUR_MCP_AUTH_HEADER=
